    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Что показывает: долю 4xx от всего HTTP-трафика. Как считается: rate выбранного класса / общий rate за $__rate_interval. Норма: зависит от клиентского трафика. Проблема: warning 10%, critical 25% при достаточном объёме. Что проверить: Top routes и Логи: обзор.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "min": 0,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(api_http_requests_total{environment=~\"$environment\",method=~\"$method\",route=~\"$route\",status_class=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(api_http_requests_total{environment=~\"$environment\",method=~\"$method\",route=~\"$route\"}[$__rate_interval])), 0.001)",
          "refId": "A"
        }
      ],
      "title": "Доля 4xx",
      "type": "stat"
    },
