FROM node:24-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
RUN npm ci --no-audit --no-fund

COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @vatrushka/shared && npm run build -w @vatrushka/api

FROM node:24-alpine AS runtime
ARG BUILD_COMMIT=unknown
ENV NODE_ENV=production
ENV BUILD_COMMIT=${BUILD_COMMIT}
WORKDIR /app
RUN addgroup -S nodeapp && adduser -S -G nodeapp nodeapp

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
RUN npm ci --omit=dev --workspace @vatrushka/api --workspace @vatrushka/shared --no-audit --no-fund && npm cache clean --force

COPY --from=build --chown=nodeapp:nodeapp /app/apps/api/dist apps/api/dist
COPY --from=build --chown=nodeapp:nodeapp /app/apps/api/drizzle apps/api/drizzle
COPY --from=build --chown=nodeapp:nodeapp /app/packages/shared/dist packages/shared/dist
COPY --chown=nodeapp:nodeapp infra/docker/api-start.sh infra/docker/runtime-connection-urls.mjs infra/docker/

USER nodeapp
EXPOSE 3000
CMD ["node", "apps/api/dist/index.js"]
