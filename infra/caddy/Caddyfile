{
  email {$ACME_EMAIL:admin@example.com}
  servers {
    protocols h1 h2 h3
  }
}

{$DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    -Server
  }
  handle_path /updates/* {
    root * /srv/updates
    header Cache-Control "no-cache, no-store, must-revalidate"
    file_server
  }
  handle {
    reverse_proxy 127.0.0.1:3001
  }
  log {
    output stdout
    format json
  }
}

{$INVITE_DOMAIN:invite.example.com} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }
  handle /i/* {
    reverse_proxy 127.0.0.1:3001
  }
  handle {
    respond "Откройте ссылку-приглашение из приложения «Ватрушка»." 404
  }
}

# Certbot uses this HTTP-only webroot to renew the TURN/TLS certificate.
http://{$TURN_DOMAIN:turn.invalid} {
  root * /var/www/certbot
  file_server
}

# Used only with infra/livekit/docker-compose.self-hosted.yml.
{$LIVEKIT_DOMAIN:livekit.invalid} {
  reverse_proxy 127.0.0.1:7880
  log {
    output stdout
    format json
  }
}
