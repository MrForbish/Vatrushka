{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@vatrushka/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "apps/desktop/.storybook/**/*.ts",
    "apps/desktop/.storybook/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": ["**/dist/**", "**/out/**", "**/release/**", "**/node_modules/**"]
}
