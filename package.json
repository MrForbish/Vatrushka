{
  "name": "vatrushka",
  "version": "0.8.13",
  "private": true,
  "description": "«Ватрушка» — настольные серверы, текстовые и голосовые каналы",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,desktop -c blue,magenta \"npm run dev:api\" \"npm run dev:desktop\"",
    "dev:api": "npm run dev -w @vatrushka/api",
    "dev:desktop": "npm run dev -w @vatrushka/desktop",
    "build": "npm run build -w @vatrushka/shared && npm run build -w @vatrushka/api && npm run build -w @vatrushka/desktop",
    "build:api": "npm run build -w @vatrushka/api",
    "build:desktop": "npm run build -w @vatrushka/desktop",
    "package:win": "npm run build -w @vatrushka/shared && npm run package:win -w @vatrushka/desktop",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run build -w @vatrushka/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @vatrushka/shared && npm run test:unit && npm run test:api && npm run test:renderer",
    "test:unit": "npm run test -w @vatrushka/shared",
    "test:api": "npm run test -w @vatrushka/api",
    "test:integration": "npm run test:integration -w @vatrushka/api",
    "test:renderer": "npm run test -w @vatrushka/desktop",
    "test:e2e": "npm run test:e2e -w @vatrushka/desktop",
    "storybook": "npm run storybook -w @vatrushka/desktop",
    "build:storybook": "npm run build-storybook -w @vatrushka/desktop",
    "test:storybook": "npm run test:storybook -w @vatrushka/desktop",
    "test:visual": "npm run test:visual -w @vatrushka/desktop",
    "perf:check": "npm run perf:check -w @vatrushka/desktop",
    "perf:bundle": "npm run perf:bundle -w @vatrushka/desktop",
    "db:check": "npm run db:check -w @vatrushka/api",
    "db:generate": "npm run db:generate -w @vatrushka/api",
    "db:migrate": "npm run db:migrate -w @vatrushka/api",
    "db:studio": "npm run db:studio -w @vatrushka/api",
    "capacity:check": "npm run capacity:check -w @vatrushka/api",
    "repo-policy:test": "node --test scripts/ci/*.test.mjs scripts/gitlab/*.test.mjs scripts/observability/*.test.mjs scripts/policy/*.test.mjs scripts/release/*.test.mjs",
    "version:check": "node scripts/release/version-check.mjs",
    "release:validate": "node scripts/release/validate.mjs",
    "release:prepare": "node scripts/release/prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hawk.so/vite-plugin": "^1.0.6",
    "@types/node": "26.1.1",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "apps/desktop/public"
    ]
  }
}
