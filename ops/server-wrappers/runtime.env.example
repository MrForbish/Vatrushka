# Root-owned, mode 0600: /etc/vatrushka/runtime.env
# This file contains paths and policy only. Keep Docker registry credentials in
# the root-owned directory referenced below, never in the application .env.
VATRUSHKA_RUNTIME_ENVIRONMENT=staging
VATRUSHKA_APP_DIR=/opt/vatrushka/current
VATRUSHKA_RUNTIME_RELEASES_DIR=/opt/vatrushka/releases
VATRUSHKA_ENV_FILE=/etc/vatrushka/app.env
VATRUSHKA_UPDATE_FEED_DIR=/opt/vatrushka/updates
VATRUSHKA_API_IMAGE_REPOSITORY=registry.gitlab.com/vatrushka-group/vatrushka/api
VATRUSHKA_REGISTRY_AUTH_DIR=/etc/vatrushka/registry
