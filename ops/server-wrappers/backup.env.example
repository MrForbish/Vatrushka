# Root-owned, mode 0600: /etc/vatrushka/backup.env
# This file is intentionally not loaded by the application or CI.
BACKUP_S3_ENDPOINT=https://s3.example.invalid
BACKUP_S3_REGION=ru-1
BACKUP_S3_BUCKET=backups-vatrushka
BACKUP_S3_PREFIX=vatrushka/postgresql
BACKUP_AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
BACKUP_AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret
# Public age recipient, not the private recovery key.
BACKUP_AGE_RECIPIENT=age1replacewiththeproductionrecoveryrecipient
