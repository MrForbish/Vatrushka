#!/usr/bin/env sh
set -eu
set -f
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077
. /usr/local/lib/vatrushka/vatrushka-wrapper-common.sh

test "$#" -eq 0 || {
  printf '%s\n' 'Production readiness does not accept arguments.' >&2
  exit 64
}

driver=/usr/local/lib/vatrushka/drivers/production-runtime-readiness.py
test -x "$driver" || {
  printf '%s\n' 'Approved production readiness driver is not installed.' >&2
  exit 64
}

exec "$driver"
