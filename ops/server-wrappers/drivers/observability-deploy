#!/usr/bin/env sh
set -eu
set -f
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

readonly RUNTIME_CONFIG=/etc/vatrushka/runtime.env
readonly OBSERVABILITY_CONFIG=/etc/vatrushka/observability.env
readonly MANIFEST_ROOT=/var/lib/vatrushka/manifests

fail() {
  printf '%s\n' "$1" >&2
  exit 64
}

require_root_file() {
  file=$1
  expected=$2
  test -f "$file" || fail "Required observability file is missing."
  owner=$(stat -c '%U:%G:%a' -- "$file") || fail "Observability file metadata cannot be read."
  test "$owner" = "$expected" || fail "Observability file permissions are unsafe."
}

test "$#" -eq 1 || fail "Exactly one canonical manifest path is required."
manifest=$1
case "$manifest" in "$MANIFEST_ROOT"/candidate-[0-9a-f]*.json) ;; *) fail "Observability manifest path is not canonical." ;; esac
require_root_file "$manifest" root:root:640
require_root_file "$RUNTIME_CONFIG" root:root:600
require_root_file "$OBSERVABILITY_CONFIG" root:root:600

manifest_checksum=$(sha256sum -- "$manifest" | awk '{print $1}') || fail "Observability manifest checksum cannot be calculated."
active_candidate="$MANIFEST_ROOT/active-candidate"
require_root_file "$active_candidate" root:root:640
test "$(tr -d '[:space:]' < "$active_candidate")" = "$manifest_checksum" || fail "Observability manifest is not the active runtime candidate."

config_values=$(python3 - "$RUNTIME_CONFIG" "$OBSERVABILITY_CONFIG" <<'PY'
import re
import sys

runtime_required = {
    "VATRUSHKA_APP_DIR": r"/[A-Za-z0-9._/-]+",
    "VATRUSHKA_ENV_FILE": r"/[A-Za-z0-9._/-]+",
}
observability_required = {
    "OBSERVABILITY_HOST": r"[a-z0-9][a-z0-9-]{0,62}",
    "OBSERVABILITY_ROLE": r"product",
    "OBSERVABILITY_ENVIRONMENT": r"(?:production|staging)",
    "OBSERVABILITY_REGION": r"[a-z0-9-]{2,32}",
    "PROMETHEUS_REMOTE_WRITE_URL": r"http://10\.90\.0\.1:9090/api/v1/write",
    "LOKI_WRITE_URL": r"http://10\.90\.0\.1:3100/loki/api/v1/push",
}

def parse(path, required):
    values = {}
    with open(path, encoding="utf-8") as source:
        for raw in source:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                raise SystemExit("Observability configuration is malformed")
            key, value = line.split("=", 1)
            if key not in required or not re.fullmatch(required[key], value):
                raise SystemExit("Observability configuration is invalid")
            values[key] = value
    if set(values) != set(required):
        raise SystemExit("Observability configuration is incomplete")
    return values

runtime = parse(sys.argv[1], runtime_required)
observability = parse(sys.argv[2], observability_required)
print(runtime["VATRUSHKA_APP_DIR"])
print(runtime["VATRUSHKA_ENV_FILE"])
for key in observability_required:
    print(observability[key])
PY
) || fail "Observability configuration is invalid."

# Do not combine command substitution with `set --`: POSIX sh reports the
# successful `set` status and can silently discard a failed validator.
set -- $config_values
test "$#" -eq 8 || fail "Observability configuration returned an invalid value count."
app_dir=$1
env_file=$2
observability_host=$3
observability_role=$4
observability_environment=$5
observability_region=$6
prometheus_remote_write_url=$7
loki_write_url=$8

require_root_file "$env_file" root:root:600
test -L "$app_dir" || fail "Runtime application path is not active."
release_dir=$(readlink -f -- "$app_dir") || fail "Runtime application path cannot be resolved."
test -f "$release_dir/infra/observability/agents/docker-compose.yml" || fail "Observability agent Compose file is missing."

cd "$release_dir"
export OBSERVABILITY_HOST="$observability_host"
export OBSERVABILITY_ROLE="$observability_role"
export OBSERVABILITY_ENVIRONMENT="$observability_environment"
export OBSERVABILITY_REGION="$observability_region"
export PROMETHEUS_REMOTE_WRITE_URL="$prometheus_remote_write_url"
export LOKI_WRITE_URL="$loki_write_url"
export ALLOY_CONFIG_FILE=product.alloy

docker compose --env-file "$env_file" -p vatrushka-observability-agent -f infra/observability/agents/docker-compose.yml --profile product --profile docker config --quiet || fail "Observability agent Compose configuration is invalid."
docker compose --env-file "$env_file" -p vatrushka-observability-agent -f infra/observability/agents/docker-compose.yml --profile product --profile docker up -d --no-build

for service in alloy node-exporter cadvisor postgres-exporter redis-exporter; do
  docker compose --env-file "$env_file" -p vatrushka-observability-agent -f infra/observability/agents/docker-compose.yml --profile product --profile docker ps --status running --services | grep -Fx "$service" >/dev/null || fail "Observability service is not running."
done

printf '%s\n' "observability=ready environment=$observability_environment"
