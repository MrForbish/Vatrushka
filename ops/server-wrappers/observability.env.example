# Root-owned, mode 0600: /etc/vatrushka/observability.env
# This file has no credentials. The agent receives database/Redis passwords only
# through the root-owned application environment used for Compose interpolation.
OBSERVABILITY_HOST=replace-with-hostname
OBSERVABILITY_ROLE=product
OBSERVABILITY_ENVIRONMENT=production
OBSERVABILITY_REGION=ru
PROMETHEUS_REMOTE_WRITE_URL=http://10.90.0.1:9090/api/v1/write
LOKI_WRITE_URL=http://10.90.0.1:3100/loki/api/v1/push
