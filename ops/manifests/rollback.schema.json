{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vatrushka immutable rollback manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseVersion", "previousCandidateSha256", "commitSha", "dependencyLockSha256", "images"],
  "properties": {
    "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "previousCandidateSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "commitSha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "dependencyLockSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
    }
  }
}
