{
  "name": "@vatrushka/api",
  "version": "0.8.35",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir integration --maxWorkers=1",
    "db:check": "node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "media:migrate:s3": "tsx src/scripts/migrate-attachments-to-s3.ts",
    "media:migrate:s3:prod": "node dist/scripts/migrate-attachments-to-s3.js",
    "media:verify:s3": "tsx src/scripts/verify-object-storage.ts",
    "media:verify:s3:prod": "node dist/scripts/verify-object-storage.js",
    "capacity:check": "tsx src/scripts/capacity-check.ts",
    "capacity:check:prod": "node dist/scripts/capacity-check.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/websocket": "^11.3.0",
    "@hawk.so/nodejs": "^3.3.2",
    "@vatrushka/shared": "0.8.35",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-raw-body": "5.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.3",
    "livekit-server-sdk": "2.17.0",
    "nodemailer": "9.0.3",
    "pg": "8.22.0",
    "redis": "^6.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.1"
  }
}
