{
  "name": "@vatrushka/desktop",
  "version": "0.8.5",
  "private": true,
  "description": "Клиент серверов и каналов «Ватрушка» для Windows",
  "author": "Ватрушка",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "build:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-icon.ps1",
    "build:production": "node scripts/build-production.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --project=renderer",
    "test:e2e": "electron-vite build --mode e2e && playwright test",
    "package:win": "npm run build:icon && powershell -NoProfile -ExecutionPolicy Bypass -File ../../infra/scripts/package-win.ps1",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project=storybook",
    "visual:serve": "vite preview --host 127.0.0.1 --port 6006 --strictPort --outDir storybook-static",
    "test:visual": "npm run build-storybook && playwright test --config=playwright.storybook.config.ts",
    "perf:check": "node scripts/check-bundle.mjs",
    "perf:bundle": "electron-vite build && node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/onest": "5.2.11",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@hawk.so/browser": "^3.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "@vatrushka/shared": "0.8.5",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "livekit-client": "2.20.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-vitest": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint-plugin-storybook": "10.5.2",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "2.0.7",
    "playwright": "1.61.1",
    "storybook": "10.5.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "ru.vatrushka.desktop",
    "productName": "Ватрушка",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Vatrushka-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Vatrushka-Portable-${version}-${arch}.${ext}"
    },
    "protocols": [
      {
        "name": "Приглашение в Ватрушку",
        "schemes": [
          "vatrushka"
        ]
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://api.myvatrushka.ru/updates",
      "channel": "latest"
    }
  }
}
