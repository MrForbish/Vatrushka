# Copy this file to .env.production before creating a client for your server.
# Public URL only. Never put API keys or server secrets here.
VITE_PUBLIC_API_BASE_URL=https://api.example.com
# Keep staged settings pages disabled until their backend vertical slices reach parity.
VITE_FEATURE_SERVER_SETTINGS_PAGE=false
VITE_FEATURE_USER_SETTINGS_PAGE=false
