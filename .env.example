NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

PUBLIC_API_URL=http://localhost:3000
PUBLIC_INVITE_URL=http://localhost:3000
APP_NAME=Ватрушка
APP_PROTOCOL=vatrushka
PLATFORM_OWNER_EMAIL=

DATABASE_URL=postgresql://vatrushka:vatrushka@localhost:5432/vatrushka

ACCESS_TOKEN_SECRET=development-access-secret-change-me-now
CREDENTIAL_ENCRYPTION_KEY=development-credential-key-change-now
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=development-otp-pepper-change-me-now
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
# Allowed only when NODE_ENV=development or test.
DEV_FIXED_OTP=123456

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@vatrushka.local
SMTP_FROM_NAME=Ватрушка

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_HTTP_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Keep database locally for development. Production media can use a private S3-compatible bucket.
MEDIA_STORAGE_DRIVER=database
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=prod
MEDIA_MAX_IMAGE_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_FILE_BYTES=52428800
MEDIA_MAX_ATTACHMENTS_PER_MESSAGE=10
MEDIA_MAX_MESSAGE_TOTAL_BYTES=262144000
MEDIA_ALLOWED_MIME_TYPES=image/gif,image/jpeg,image/png,image/webp,video/mp4,video/webm,audio/mpeg,audio/ogg,audio/wav,application/pdf,application/zip,text/plain

# Ephemeral online/idle state. Production must use Redis; preferences remain in PostgreSQL.
PRESENCE_STORAGE_DRIVER=memory
REDIS_URL=redis://:replace-with-a-long-random-password@127.0.0.1:6379/0
REDIS_PASSWORD=replace-with-a-long-random-password
PRESENCE_HEARTBEAT_SECONDS=20
PRESENCE_TTL_SECONDS=75

SCREEN_SHARE_LEASE_SECONDS=30
SCREEN_SHARE_HEARTBEAT_SECONDS=10

# Comma-separated extra origins. Electron's null origin is supported explicitly.
CORS_ALLOWED_ORIGINS=

# Used by Caddy / Docker Compose deployment.
DOMAIN=api.example.com
INVITE_DOMAIN=example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com
POSTGRES_DB=vatrushka
POSTGRES_USER=vatrushka
POSTGRES_PASSWORD=replace-with-a-long-random-password
