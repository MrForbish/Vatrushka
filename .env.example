NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

PUBLIC_API_URL=http://localhost:3000
PUBLIC_INVITE_URL=http://localhost:3000
APP_NAME=Ватрушка
APP_PROTOCOL=vatrushka
PLATFORM_OWNER_EMAIL=

DATABASE_URL=postgresql://vatrushka:vatrushka@localhost:5432/vatrushka

ACCESS_TOKEN_SECRET=development-access-secret-change-me-now
CREDENTIAL_ENCRYPTION_KEY=development-credential-key-change-now
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PEPPER=development-otp-pepper-change-me-now
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
# Allowed only when NODE_ENV=development or test.
DEV_FIXED_OTP=123456

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@vatrushka.local
SMTP_FROM_NAME=Ватрушка

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_HTTP_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SCREEN_SHARE_LEASE_SECONDS=30
SCREEN_SHARE_HEARTBEAT_SECONDS=10

# Comma-separated extra origins. Electron's null origin is supported explicitly.
CORS_ALLOWED_ORIGINS=

# Used by Caddy / Docker Compose deployment.
DOMAIN=api.example.com
INVITE_DOMAIN=example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com
POSTGRES_DB=vatrushka
POSTGRES_USER=vatrushka
POSTGRES_PASSWORD=replace-with-a-long-random-password
